{
    "name": "gotestexplorer",
    "displayName": "Go Test Explorer",
    "description": "Run and explore Go tests in a tree view",
    "version": "0.3.0",
    "license": "MIT",
    "publisher": "premparihar",
    "engines": {
        "vscode": "^1.85.0"
    },
    "keywords": [
        "go",
        "test",
        "gotest",
        "unit test",
        "testing"
    ],
    "categories": [
        "Testing"
    ],
    "activationEvents": [
        "onView:goTestExplorer"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "Go Test Explorer",
            "properties": {
                "goTestExplorer.maxParallelTests": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 1,
                    "description": "The number of test runs that are allowed to be in flight at the same time."
                },
                "goTestExplorer.maxPackagesPerRun": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "description": "The most packages that one go test run tests when Run All tests a module. 0 means no limit on the number: the packages are split into several runs, one after another, only when their names would be too long for a command line."
                },
                "goTestExplorer.skipFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "vendor",
                        ".vscode",
                        ".git",
                        ".idea",
                        "node_modules",
                        "testdata",
                        "dist",
                        "build",
                        "out",
                        "third_party",
                        "proto",
                        "generated",
                        "__pycache__",
                        ".venv",
                        "coverage"
                    ],
                    "description": "The names of the folders that are never walked while looking for test files."
                },
                "goTestExplorer.goPath": {
                    "type": "string",
                    "default": "",
                    "description": "The GOPATH that the go tool is run with. Empty means the GOPATH of the Go extension, or the one Go finds by itself."
                },
                "goTestExplorer.goBinary": {
                    "type": "string",
                    "default": "",
                    "description": "The path of the go binary. Empty means the one on the PATH, or the one the Go extension names in go.alternateTools."
                },
                "goTestExplorer.testFlags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "The flags that are added to the go test command. Falls back to go.testFlags of the Go extension."
                },
                "goTestExplorer.buildTags": {
                    "type": "string",
                    "default": "",
                    "description": "The build tags of a test run. Falls back to go.buildTags of the Go extension."
                },
                "goTestExplorer.timeout": {
                    "type": "string",
                    "default": "30s",
                    "description": "The timeout of a test run. Falls back to go.testTimeout of the Go extension."
                },
                "goTestExplorer.envFile": {
                    "type": "string",
                    "default": "",
                    "description": "The file that holds the environment variables of a test run. Falls back to go.testEnvFile of the Go extension."
                },
                "goTestExplorer.env": {
                    "type": "object",
                    "default": {},
                    "description": "The environment variables of a test run. Falls back to go.testEnvVars of the Go extension."
                },
                "goTestExplorer.showFilesWithoutTests": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether a test file that has no Test function is listed. Such a file holds helpers that a test in another file runs, so there is nothing to run in it. When it is listed it is marked \"no tests\" and a click opens it."
                },
                "goTestExplorer.runInTerminal": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the output of a test run is written to a terminal. When false it is written to an output channel instead."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "testExplorer",
                    "title": "go Test Explorer",
                    "icon": "media/test.svg"
                }
            ]
        },
        "views": {
            "testExplorer": [
                {
                    "id": "goTestExplorer",
                    "name": "Test"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "goTestExplorer.showCoverage",
                    "when": "view == goTestExplorer && !goTestExplorer.coverageEnabled",
                    "group": "navigation@6"
                },
                {
                    "command": "goTestExplorer.hideCoverage",
                    "when": "view == goTestExplorer && goTestExplorer.coverageEnabled",
                    "group": "navigation@6"
                },
                {
                    "command": "goTestExplorer.collapseAll",
                    "when": "view == goTestExplorer && goTestExplorer.allExpanded",
                    "group": "navigation@5"
                },
                {
                    "command": "goTestExplorer.expandAll",
                    "when": "view == goTestExplorer && !goTestExplorer.allExpanded",
                    "group": "navigation@5"
                },
                {
                    "command": "goTestExplorer.filterTests",
                    "when": "view == goTestExplorer && !goTestExplorer.filterActive",
                    "group": "navigation@3"
                },
                {
                    "command": "goTestExplorer.clearFilter",
                    "when": "view == goTestExplorer && goTestExplorer.filterActive",
                    "group": "navigation@3"
                },
                {
                    "command": "goTestExplorer.refreshTestExplorer",
                    "when": "view == goTestExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "goTestExplorer.runAllTest",
                    "when": "view == goTestExplorer",
                    "group": "navigation@0"
                },
                {
                    "command": "goTestExplorer.cancelTestRun",
                    "when": "view == goTestExplorer",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "goTestExplorer.runTest",
                    "when": "viewItem == test"
                },
                {
                    "command": "goTestExplorer.showTestoutput",
                    "when": "viewItem == test"
                },
                {
                    "command": "goTestExplorer.runTestSuite",
                    "when": "viewItem == testSuite"
                }
            ]
        },
        "commands": [
            {
                "command": "goTestExplorer.showCoverage",
                "title": "Show Code Coverage",
                "icon": "$(shield)"
            },
            {
                "command": "goTestExplorer.showCoverageReport",
                "title": "Show Code Coverage by File"
            },
            {
                "command": "goTestExplorer.hideCoverage",
                "title": "Hide Code Coverage",
                "icon": "$(eye-closed)"
            },
            {
                "command": "goTestExplorer.collapseAll",
                "title": "Collapse All",
                "icon": "$(collapse-all)"
            },
            {
                "command": "goTestExplorer.expandAll",
                "title": "Expand All",
                "icon": "$(expand-all)"
            },
            {
                "command": "goTestExplorer.filterTests",
                "title": "Filter Tests",
                "icon": "$(filter)"
            },
            {
                "command": "goTestExplorer.clearFilter",
                "title": "Clear Filter",
                "icon": "$(filter-filled)"
            },
            {
                "command": "goTestExplorer.cancelTestRun",
                "title": "Cancel Test Run",
                "icon": "$(debug-stop)"
            },
            {
                "command": "goTestExplorer.refreshTestExplorer",
                "title": "Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "goTestExplorer.runTestSuite",
                "title": "Run",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.runTest",
                "title": "Run",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.runAllTest",
                "title": "Run All",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.goToLocation",
                "title": "Go here",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.showTestoutput",
                "title": "show output",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            }
        ]
    },
    "scripts": {
        "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
        "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch=forever",
        "typecheck": "tsc -p ./ --noEmit && tsc -p ./bench --noEmit",
        "test": "npm run typecheck && vitest run",
        "test:watch": "vitest",
        "bench": "tsx --tsconfig ./bench/tsconfig.runtime.json bench/run-bench.ts",
        "bench:discovery": "tsx --tsconfig ./bench/tsconfig.runtime.json bench/discovery-bench.ts",
        "bench:exec": "tsx --tsconfig ./bench/tsconfig.runtime.json bench/exec-bench.ts",
        "lint": "eslint src --max-warnings 0",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "compile:tsc": "tsc -p ./",
        "vscode:prepublish": "npm run compile",
        "package": "vsce package",
        "package:dry": "vsce ls"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/eslint__js": "^8.42.3",
        "@types/node": "^20.19.43",
        "@types/vscode": "~1.85.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^2.1.9"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ppparihar/gotestexplorer.git"
    },
    "bugs": {
        "url": "https://github.com/ppparihar/gotestexplorer/issues"
    },
    "icon": "media/icon.png"
}
