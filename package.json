{
    "name": "gotestexplorer",
    "displayName": "Go Test Explorer",
    "description": "Go Test Explorer",
    "version": "0.1.13",
    "publisher": "premparihar",
    "engines": {
        "vscode": "^1.85.0"
    },
    "keywords": [
        "go",
        "test",
        "gotest",
        "unit test"
    ],
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onView:goTestExplorer"
    ],
    "main": "./out/extension",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "testExplorer",
                    "title": "go Test Explorer",
                    "icon": "media/test.svg"
                }
            ]
        },
        "views": {
            "testExplorer": [
                {
                    "id": "goTestExplorer",
                    "name": "Test"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "goTestExplorer.refreshTestExplorer",
                    "when": "view == goTestExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "goTestExplorer.runAllTest",
                    "when": "view == goTestExplorer",
                    "group": "navigation@0"
                }
            ],
            "view/item/context": [
                {
                    "command": "goTestExplorer.runTest",
                    "when": "viewItem == test"
                },
                {
                    "command": "goTestExplorer.showTestoutput",
                    "when": "viewItem == test"
                },
                {
                    "command": "goTestExplorer.runTestSuite",
                    "when": "viewItem == testSuite"
                }
            ]
        },
        "commands": [
            {
                "command": "goTestExplorer.refreshTestExplorer",
                "title": "Refresh",
                "icon": {
                    "light": "resources/light/refresh.svg",
                    "dark": "resources/dark/refresh.svg"
                }
            },
            {
                "command": "goTestExplorer.runTestSuite",
                "title": "Run",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.runTest",
                "title": "Run",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.runAllTest",
                "title": "Run All",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.goToLocation",
                "title": "Go here",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            },
            {
                "command": "goTestExplorer.showTestoutput",
                "title": "show output",
                "icon": {
                    "light": "resources/light/run.png",
                    "dark": "resources/dark/run.png"
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "typecheck": "tsc -p ./ --noEmit && tsc -p ./bench --noEmit",
        "test": "npm run typecheck && vitest run",
        "test:watch": "vitest",
        "bench": "tsx --tsconfig ./bench/tsconfig.runtime.json bench/run-bench.ts",
        "bench:discovery": "tsx --tsconfig ./bench/tsconfig.runtime.json bench/discovery-bench.ts",
        "bench:exec": "tsx --tsconfig ./bench/tsconfig.runtime.json bench/exec-bench.ts"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/vscode": "~1.85.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ppparihar/gotestexplorer.git"
    },
    "bugs": {
        "url": "https://github.com/ppparihar/gotestexplorer/issues"
    },
    "badges": [
        {
            "url": "https://travis-ci.org/ppparihar/GoTestExplorer.svg?branch=master",
            "href": "https://travis-ci.org/ppparihar/GoTestExplorer",
            "description": "Continuous integration (Travis)"
        }
    ],
    "icon": "media/icon.png"
}
