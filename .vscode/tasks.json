// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            // Rebuilds dist/extension.js on every change. The debugger waits for
            // the first "build finished" line before it launches.
            "type": "npm",
            "script": "watch",
            "isBackground": true,
            "problemMatcher": {
                "owner": "esbuild",
                "fileLocation": "relative",
                "pattern": [
                    {
                        "regexp": "^✘ \\[ERROR\\] (.*)$",
                        "message": 1
                    },
                    {
                        "regexp": "^\\s+(.*):(\\d+):(\\d+):",
                        "file": 1,
                        "line": 2,
                        "column": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[watch\\] build started",
                    "endsPattern": "^\\[watch\\] build finished"
                }
            },
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
